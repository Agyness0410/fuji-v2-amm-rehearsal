# Copy the relevant values into packages/hardhat/.env and
# packages/nextjs/.env.local. Never commit either real env file.

# Public Fuji C-Chain RPC. Replace with your provider if the public endpoint is rate limited.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_TARGET_NETWORK=localhost

# Create an encrypted deployer account with `yarn generate`; do not paste a plaintext private key here.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Optional, for contract verification.
SNOWTRACE_API_KEY=

# Recommended for wallet connection in a deployed frontend.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
